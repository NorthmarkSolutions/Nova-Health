# =============================================================================
# Root .gitignore - North Hospital HMS Enterprise
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Environment Variables & Confidential Credentials (CRITICAL - NEVER COMMIT)
# -----------------------------------------------------------------------------
.env
.env.*
*.env
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local
backend/.env
backend/.env.*
backend/*.env
frontend/.env
frontend/.env.*
frontend/*.env
frontend/.env.development
frontend/.env.production
frontend/.env.development.local
frontend/.env.production.local
frontend/.env.test.local
*.local
!.env.example
!*.env.example
!backend/.env.example
!frontend/.env.example
*.pem
*.key
*.cert
*.crt
secrets/
credentials/
auth_tokens/

# -----------------------------------------------------------------------------
# 2. Node & Frontend Dependencies & Builds
# -----------------------------------------------------------------------------
node_modules/
frontend/node_modules/
dist/
dist-ssr/
frontend/dist/
frontend/build/
.npm/
.yarn/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# -----------------------------------------------------------------------------
# 3. Python & Backend Environments
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
backend/venv/
backend/env/
backend/ENV/
venv/
env/
ENV/
.venv/
backend/staticfiles/
media/
backend/media/
backend/uploads/

# -----------------------------------------------------------------------------
# 4. Databases & Local Storage
# -----------------------------------------------------------------------------
*.sqlite3
*.db
backend/*.sqlite3
backend/*.db
backend/north_hospital.sqlite3
*.dump
*.sql

# -----------------------------------------------------------------------------
# 5. Testing & Coverage
# -----------------------------------------------------------------------------
.pytest_cache/
.coverage
htmlcov/
.tox/
coverage/

# -----------------------------------------------------------------------------
# 6. IDEs & Operating System Artifacts
# -----------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.vscode/
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
